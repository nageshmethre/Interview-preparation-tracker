{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "/api/send-otp", "dest": "/api/send-otp.js" },
    { "src": "/api/(.*)", "dest": "https://api.stream-in.app/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
